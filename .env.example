# --- Access control (required) -------------------------------------------
# The single shared login for the portal. Change BOTH before deploying.
PORTAL_USER=jamarik
PORTAL_PASSWORD=change-me-in-vercel

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- Trade Detective (optional) ------------------------------------------
